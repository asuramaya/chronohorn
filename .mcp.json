{
  "mcpServers": {
    "chronohorn": {
      "command": "python",
      "args": [
        "-m",
        "chronohorn.mcp_transport"
      ],
      "env": {
        "PYTHONPATH": "python"
      }
    },
    "heinrich": {
      "command": "/home/asuramaya/code/REPOS/heinrich/.venv/bin/heinrich-mcp",
      "args": []
    },
    "osiris": {
      "type": "http",
      "url": "http://127.0.0.1:8790/mcp",
      "headers": {
        "X-Osiris-Job": "${CLAUDE_JOB_DIR}"
      }
    }
  }
}
